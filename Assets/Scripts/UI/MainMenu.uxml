<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Scripts/UI/MainMenu.uss?fileID=7433441132597879392&amp;guid=e48650b18525b5061b14e9ec17907458&amp;type=3#MainMenu" />
    <ui:VisualElement name="VisualElement" style="width: 100%; height: 100%; align-items: center; justify-content: center; padding-top: 64px; padding-bottom: 64px;">
        <ui:Button text="Ayarlar" name="Settings" style="align-self: center; background-color: rgb(106, 25, 75); -unity-font-style: bold; color: rgb(255, 255, 255); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; justify-content: center; align-items: center;" />
        <ui:VisualElement name="VisualElement" style="width: 100%; flex-direction: column; justify-content: center; align-items: center; align-self: center; flex-wrap: wrap;">
            <ui:Button text="Solo Game" name="SoloPlayer" class="btn" style="width: 40%;" />
            <ui:Button text="Multyplayer" name="Multyplayer" class="btn" style="width: 40%;" />
