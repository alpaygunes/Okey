        <ui:VisualElement name="MenuBox" class="MenuBox" style="background-color: rgba(255, 255, 255, 0.16); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; height: 256px; display: none;">
            <ui:Button name="ZamanLimitliBtn" text="Zaman Limitli" class="button sure_limitli_btn btn_size btn" style="background-size: contain; -unity-background-scale-mode: scale-to-fit; background-image: none; background-color: rgba(188, 188, 188, 0); background-position-x: center 0; background-position-y: center 0;" />
            <ui:Button name="GorevYap" text="Görev Limitli" class="button gorevli_btn btn_size btn" />
